# 复制为 .env，仅在本地填写。禁止上传实际密码或地址。
POSTGRES_PASSWORD=
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
# Compose 内数据库主机名是 db，数据库 studio，用户名 ff7rb。
# 连接串含密码；本地开发访问数据库映射端口时主机名和端口不同。
DATABASE_URL=
TTS_URL=http://tts-proxy:8810
# 网站只连接统一代理，后端数量与地址由代理配置。
TTS_URLS=http://tts-proxy:8810
TTS_MAX_INFLIGHT=8
# 后端值填写主机与端口；只放在本地 .env。
TTS_BACKEND_1=
TTS_BACKEND_2=
QWEN_ASR_URL=
MORA_URL=http://mora:8000
REWRITE_LLM_URL=
REWRITE_LLM_MODEL=
REWRITE_LLM_KEY=
# 火山Agent Plan独立连接，实际地址和密钥只填在本机.env。
VOLCENGINE_LLM_URL=
VOLCENGINE_LLM_MODEL=deepseek-v4.1-flash
VOLCENGINE_LLM_KEY=
SELF_HOSTED_LLM_URL=
SELF_HOSTED_LLM_MODEL=
SELF_HOSTED_LLM_KEY=
SEEDASR_API_KEY=
SEEDASR_RESOURCE_ID=volc.seedasr.auc
AUTO_RUN_ORIGIN=http://127.0.0.1:8765
# 备份脚本读取进程环境变量；请在本地受控的调度配置中导出。
BACKUP_DEST=
MOD_BACKUP_DIR=
