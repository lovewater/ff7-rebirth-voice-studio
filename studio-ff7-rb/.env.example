# 复制为 .env，仅在本地填写。禁止上传实际密码或地址。
POSTGRES_PASSWORD=
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
# Compose 内数据库主机名是 db，数据库 studio，用户名 ff7rb。
# 连接串含密码；本地开发访问数据库映射端口时主机名和端口不同。
DATABASE_URL=
TTS_URL=
# 可选，多个推理地址用逗号分隔；留空时沿用 TTS_URL。
TTS_URLS=
QWEN_ASR_URL=
MORA_URL=http://mora:8000
REWRITE_LLM_URL=
REWRITE_LLM_MODEL=
REWRITE_LLM_KEY=
SELF_HOSTED_LLM_URL=
SELF_HOSTED_LLM_MODEL=
SELF_HOSTED_LLM_KEY=
SEEDASR_API_KEY=
SEEDASR_RESOURCE_ID=volc.seedasr.auc
AUTO_RUN_ORIGIN=http://127.0.0.1:8765
# 备份脚本读取进程环境变量；请在本地受控的调度配置中导出。
BACKUP_DEST=
MOD_BACKUP_DIR=
